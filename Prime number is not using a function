include <stdio.h>

// Function to check prime
int isPrime(int n) {
    int i;

    if(n <= 1)
        return 0;

    for(i = 2; i <= n/2; i++) {
        if(n % i == 0)
            return 0;
    }
    return 1;
}

int main() {
    int num, result;
    printf (“reg no:25331A05H5 \n”);
    printf("Enter a number: ");
    scanf("%d", &num);

    result = isPrime(num);

    if(result == 1)
        printf("Number is Prime");
    else
        printf("Number is Not Prime");

    return 0;
}
