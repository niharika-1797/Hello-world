#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], copyStr[100], concatStr[200];
    int length, compare;

     printf (“reg no:25331A05H5 \n”);
    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    
    strcpy(copyStr, str1);
    printf("\nCopied string: %s", copyStr);

    
    strcpy(concatStr, str1);   // Copy first string
    strcat(concatStr, str2);   // Append second string
    printf("\nConcatenated string: %s", concatStr);

    
    compare = strcmp(str1, str2);
    if (compare == 0)
        printf("\nStrings are equal");
    else if (compare < 0)
        printf("\nFirst string is smaller than second");
    else
        printf("\nFirst string is greater than second");

    
    length = strlen(str1);
    printf("\nLength of first string: %d", length);

    return 0;
}
